# App
ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string

# Database (docker-compose overrides this with the 'db' service host)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobassistant

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Job APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
